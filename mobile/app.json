{
  "expo": {
    "name": "Rider Comms",
    "slug": "rider-comms",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ridercomms",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-secure-store",
      "expo-location",
      "expo-notifications",
      "expo-status-bar",
      "react-native-maps"
    ],
    "ios": {
      "bundleIdentifier": "com.ridercomms.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:alidd11.github.io"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rider Comms uses your location while the app is open to find riders who are mutually within your selected zone.",
        "NSMicrophoneUsageDescription": "Rider Comms uses your microphone for hands-free group voice chat during a ride.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.ridercomms.app",
      "versionCode": 1,
      "backgroundColor": "#080D10",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "alidd11.github.io",
              "pathPrefix": "/rider-comms/navigate"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT",
        "POST_NOTIFICATIONS"
      ]
    }
  }
}
