{
  "expo": {
    "name": "Rider Comms",
    "slug": "rider-comms",
    "version": "0.1.0",
    "orientation": "portrait",
    "plugins": ["expo-secure-store", "expo-location"],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rider Comms uses your location while the app is open to find riders who are mutually within your selected zone."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    }
  }
}
