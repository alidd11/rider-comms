{
  "name": "@rider-comms/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test:client": "node --experimental-strip-types --test tests/*.test.ts",
    "test:jest": "jest",
    "test:client:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-exclude='../shared/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=../coverage/mobile-client.lcov --test tests/*.test.ts",
    "test:jest:coverage": "jest --runInBand --coverage --coverageReporters=lcov --coverageReporters=text-summary --coverageDirectory=../coverage/jest"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@expo/vector-icons": "^15.0.2",
    "@livekit/react-native": "3.0.0",
    "@livekit/react-native-expo-plugin": "1.0.3",
    "@livekit/react-native-webrtc": "144.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@rider-comms/shared": "*",
    "@supersami/rn-foreground-service": "2.2.5",
    "expo": "~58.0.24",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-haptics": "~58.0.8",
    "expo-iap": "5.8.2",
    "expo-live-activity": "0.4.2",
    "expo-location": "~58.0.21",
    "expo-navigation-bar": "~58.0.4",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "livekit-client": "^2.22.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "_NOTE": "Expo Go is suitable for UI/map testing only. LiveKit voice requires a native development/preview build because its WebRTC modules are not available in Expo Go. Standalone Android map tiles still require a restricted Maps SDK key and a rebuilt binary.",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@supersami/rn-foreground-service",
          "@livekit/react-native-expo-plugin",
          "expo-live-activity"
        ]
      }
    }
  }
}
