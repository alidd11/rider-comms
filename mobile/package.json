{
  "name": "@rider-comms/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test:client": "node --experimental-strip-types --test tests/*.test.ts",
    "test:jest": "jest",
    "test:client:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-exclude='../shared/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=../coverage/mobile-client.lcov --test tests/*.test.ts",
    "test:jest:coverage": "jest --coverage --coverageReporters=lcov --coverageReporters=text-summary --coverageDirectory=../coverage/jest"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@expo/vector-icons": "^15.0.2",
    "@livekit/react-native": "3.0.0",
    "@livekit/react-native-expo-plugin": "1.0.3",
    "@livekit/react-native-webrtc": "144.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@rider-comms/shared": "*",
    "@supersami/rn-foreground-service": "2.2.5",
    "expo": "~57.0.26",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-location": "~57.0.20",
    "expo-navigation-bar": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "livekit-client": "^2.22.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "^1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.4",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "_NOTE": "Expo Go is suitable for UI/map testing only. LiveKit voice requires a native development/preview build because its WebRTC modules are not available in Expo Go. Standalone Android map tiles still require a restricted Maps SDK key and a rebuilt binary.",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@supersami/rn-foreground-service",
          "@livekit/react-native-expo-plugin"
        ]
      }
    }
  }
}
