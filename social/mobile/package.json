    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.0",
    "expo-font": "~58.0.12",
    "react-native-safe-area-context": "~5.11.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-image-picker": "~58.0.10",
    "expo-video": "~58.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "@playwright/test": "^1.55.1"
  },
  "type": "module"
