# Copy to .env on the server (never commit .env).
# DNS A record for this name must point at the VPS before first start.
LIVEKIT_DOMAIN=voice.example.com
# "<api key>: <api secret>". Generate with:
#   echo "API$(openssl rand -hex 6): $(openssl rand -base64 36 | tr -d '/+=')"
LIVEKIT_KEYS=APIxxxxxxxxxxxx: replace-with-a-long-random-secret
