# Use HTTPS outside local development.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Required before a public store submission.
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms

# GitHub Actions repository secret for the PWA. Restrict this browser key to
# the Maps JavaScript API and the exact GitHub Pages HTTPS origin.
GOOGLE_MAPS_API_KEY=

# Native app's map search bar (mobile/src/api/places.ts). Restrict this key
# in the Google Cloud console to the Places API and this app's iOS bundle
# ID / Android package name + SHA-1 fingerprint, not a browser origin.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Pre-release native in-app turn-by-turn route requests. Keep this key
# separate from Places so permissions cannot be widened accidentally. Enable
# only the Google Directions API needed by development builds. Before public
# release, replace this client-side route fetch with an approved navigation SDK
# or server-side route service so a web-service credential is not shipped in
# the app bundle.
EXPO_PUBLIC_GOOGLE_DIRECTIONS_API_KEY=

# Backend-only Google Directions web-service credential. Never expose this as
# EXPO_PUBLIC_*. Restrict it to the Directions API and, where the production
# host has stable egress addresses, restrict requests to those server IPs.
GOOGLE_DIRECTIONS_API_KEY=

# Backend runtime. Use comma-separated exact origins without path segments.
CORS_ALLOWED_ORIGINS=https://alidd11.github.io
TRUST_PROXY=false
HOST=0.0.0.0
PORT=4000

# Comma-separated durable rider IDs that receive backend admin privileges
# during startup. Scenic-route publishing is admin-only. Removing an ID does
# not automatically revoke an existing grant; demotion is an explicit DB/admin
# operation so a configuration edit cannot silently strip privileges.
ADMIN_RIDER_IDS=

# Postgres connection for real account signup/login (backend/src/db.ts,
# backend/src/authStore.ts). On Railway this is set via a reference
# variable to the "Postgres" service and never needs to be typed by hand;
# for local development point it at your own Postgres instance. Production
# authentication requires durable account sessions; no anonymous guest auth
# endpoint is exposed.
DATABASE_URL=

# Voice transport (backend/src/liveKitToken.ts, POST /voice/token). Leave
# unset and the endpoint returns 503 voice_not_configured — the rest of the
# app works fine without it. LIVEKIT_URL is the wss:// endpoint your
# LiveKit deployment (self-hosted or LiveKit Cloud) gives you; API key/secret
# come from that same deployment and must never reach any client — only
# this backend signs tokens with them.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Verification emails on signup (backend/src/email.ts, via Resend --
# https://resend.com). Leave unset and signup still works end-to-end; it
# just logs a warning and skips sending, so accounts are created with
# email_verified_at left NULL until Resend is configured (or the rider
# calls POST /auth/resend-verification later). RESEND_FROM_EMAIL must be a
# sender address/domain verified in the Resend dashboard.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Public HTTPS root opened by verification emails. Defaults to the GitHub
# Pages PWA; override it when a production app domain is available.
PUBLIC_APP_URL=https://alidd11.github.io/rider-comms/
